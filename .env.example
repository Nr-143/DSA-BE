# ──────────────────────────────────────────
# DSA Tracker — Backend Environment Variables
# ──────────────────────────────────────────

# Server port (default: 3001)
PORT=3001

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/dsa_tracker
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dsa_tracker?retryWrites=true&w=majority

# Session / JWT secrets (future use)
# SESSION_SECRET=your-random-secret-here
# JWT_SECRET=your-jwt-secret-here
